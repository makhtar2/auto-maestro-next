# ============================================================
# AUTO MAESTRO LLC - Production & Local Configuration Guide
# ============================================================

# 1. Cloudinary Integration (Image Upload & CDN Optimization)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# 2. Admin Operations Terminal Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_long_random_session_secret_string

# 3. Email Notifications (Resend API)
RESEND_API_KEY=re_123456789_your_key
ADMIN_EMAIL=contact@automaestrocars.com
EMAIL_FROM="Auto Maestro LLC <onboarding@resend.dev>"

# 4. Public Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=contact@automaestrocars.com
NEXT_PUBLIC_CONTACT_PHONE="+1 (513) 555-0199"
NEXT_PUBLIC_CONTACT_ADDRESS="AUTO MAESTRO LLC Main Showroom"

# 5. Production Serverless Persistence (Vercel KV / Upstash Redis)
# Highly recommended for Vercel deployment so inventory and leads persist permanently
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token

# 6. Optional: GitHub Auto-Sync (Alternative Persistence)
# GITHUB_TOKEN=ghp_your_personal_access_token
# GITHUB_REPO=makhtar2/auto-maestro-next

